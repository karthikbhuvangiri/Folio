# ==============================================================
# Folio Configuration
# Copy this file to .env and fill in your values, or run:
#   python3 setup.py
# to generate a matching .env interactively.
# ==============================================================

# -----------------------------------------------------------------
# AI Mode
# -----------------------------------------------------------------
# Local AI is the only supported LLM mode.
#   LLM_PROVIDER=ollama
#   ENABLE_LOCAL_ENRICHMENT=true
#   ENABLE_LLM_CATEGORIZATION=true
#   OLLAMA_BASE_URL=http://host.docker.internal:11434   # Docker runtime
#   OLLAMA_BASE_URL=http://localhost:11434              # Local dev runtime
#
# To run without AI:
#   ENABLE_LOCAL_ENRICHMENT=false
#   ENABLE_LLM_CATEGORIZATION=false
#   RECEIPT_INTELLIGENCE_ENABLED=false
#   MIRA_ENABLED=false
#   ENABLE_TROVE=false
#
# To categorize without a local LLM, use the optional DistilBERT backend:
#   CATEGORIZATION_BACKEND=distilbert
#   INSTALL_DISTILBERT=true
#   ENABLE_LOCAL_ENRICHMENT=false
#   ENABLE_TROVE=false
#   MIRA_ENABLED=false
#
# On macOS and Windows, Local AI expects Ollama to run natively on the host OS.
# The backend container connects to it through host.docker.internal.

# -----------------------------------------------------------------
# Teller Certificates (required)
# -----------------------------------------------------------------
# Get these from https://teller.io — mTLS certificate pair
# Docker runtime: place files in ./certs and keep the defaults below.
# Local runtime:  you can use absolute or relative paths.
TELLER_CERT_PATH=certs/teller-cert.pem
TELLER_KEY_PATH=certs/teller-key.pem

# -----------------------------------------------------------------
# Teller Connect (optional but recommended)
# -----------------------------------------------------------------
# Lets users link accounts from the UI with the "+" button.
TELLER_APPLICATION_ID=
TELLER_ENVIRONMENT=sandbox

# -----------------------------------------------------------------
# Token Encryption (required)
# -----------------------------------------------------------------
# Generate one:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# -----------------------------------------------------------------
# Teller Access Tokens (legacy / manual)
# -----------------------------------------------------------------
# Format: FIRSTNAME_BANKNAME_TOKEN=token_value
# The part before the first underscore becomes the profile name.
# Examples:
#   JOHN_BOFA_TOKEN=test_tok_abc123
#   JOHN_CHASE_TOKEN=test_tok_def456
#   SARAH_AMEX_TOKEN=test_tok_ghi789
# Uncomment and fill in as needed:
# YOURNAME_BANKNAME_TOKEN=

# -----------------------------------------------------------------
# Security
# -----------------------------------------------------------------
# API key for backend authentication. VITE_API_KEY should match.
Folio_API_KEY=
VITE_API_KEY=

# -----------------------------------------------------------------
# Feature Toggles
# -----------------------------------------------------------------
DEMO_MODE=false
ENABLE_TROVE=false
ENABLE_LOCAL_ENRICHMENT=true
ENABLE_LLM_CATEGORIZATION=true
# Unset preserves legacy behavior. Supported: local_llm, distilbert, rules_only.
CATEGORIZATION_BACKEND=
ENABLE_EXPERIMENTAL_LOCAL_MODELS=false
# Receipt parsing uses the local receipt model. Disable in No-AI mode.
RECEIPT_INTELLIGENCE_ENABLED=true
# Controls whether the Mira nav/page is advertised in the frontend.
MIRA_ENABLED=true
COPILOT_MAX_WRITE_ROWS=5000
# Mira vNext is the only supported Copilot runtime.
MIRA_AGENTIC_RUNTIME=vnext
# vNext answer token budgets. General chat needs more room than grounded
# finance answers; Ollama receives these as num_predict.
MIRA_VNEXT_EVIDENCE_MAX_TOKENS=180
MIRA_VNEXT_GENERAL_MAX_TOKENS=1000
# Phase 16: skip the selector LLM for short-lived exact repeated turns.
# Validation/tools still run fresh; set enabled=false to roll back.
MIRA_SELECTOR_DECISION_CACHE_ENABLED=1
MIRA_SELECTOR_DECISION_CACHE_TTL_SECONDS=300
MIRA_SELECTOR_DECISION_CACHE_MAX=128
# Phase 16B: make the selector emit a smaller JSON object to reduce decode time.
# Disable to roll back to the previous full selector response schema.
MIRA_SELECTOR_COMPACT_OUTPUT_ENABLED=1
# Phase 18: experimental front-controller protocol. Default off because it
# changes the chat serving path. When enabled with the family fast lanes below,
# broad chat, scalar finance, read-only finance, charts, write-preview, memory
# slash commands, and explain-last use the front-controller or deterministic
# paths. Re-enable selector fallback only as a rollback escape hatch.
MIRA_FRONT_CONTROLLER_PROTOCOL_ENABLED=0
MIRA_FRONT_CONTROLLER_CHAT_FAST_LANE_ENABLED=1
MIRA_FRONT_CONTROLLER_FINANCE_SCALAR_FAST_LANE_ENABLED=0
MIRA_FRONT_CONTROLLER_READ_ONLY_TABLE_FAST_LANE_ENABLED=0
MIRA_FRONT_CONTROLLER_CHART_FAST_LANE_ENABLED=0
MIRA_FRONT_CONTROLLER_EXPLAIN_COMPARE_FAST_LANE_ENABLED=0
MIRA_FRONT_CONTROLLER_WRITE_PREVIEW_FAST_LANE_ENABLED=0
MIRA_EXPLAIN_LAST_FAST_LANE_ENABLED=0
MIRA_MEMORY_SLASH_BYPASS_ENABLED=1
MIRA_VNEXT_SELECTOR_FALLBACK_ENABLED=0
# Phase 18.7: evidence-first streaming for read-only complex finance. Keep off
# by default until local evals show no regressions on the target machine.
MIRA_FRONT_CONTROLLER_COMPLEX_FINANCE_REACT_LITE_ENABLED=0
MIRA_COMPLEX_FINANCE_PREVIEW_LLM_ENABLED=0
MIRA_COMPLEX_FINANCE_PREVIEW_MAX_TOKENS=80
MIRA_COMPLEX_FINANCE_PREVIEW_ONLY_ENABLED=1
MIRA_FRONT_CONTROLLER_MAX_TOKENS=900
MIRA_FRONT_CONTROLLER_BACKGROUND_DRAIN_ENABLED=0
MIRA_MEMORY_SUGGESTIONS_ON_EVIDENCE_ENABLED=0
# Phase 18.88D/18.91: optional guarded one-model background rewarm after
# evidence answers. Off by default for release builds; enable when tuning local
# TTFT. Pending rewarm is cancelled if a real request arrives before it starts;
# running rewarm is telemetry-guarded but cannot be aborted by Ollama.
MIRA_FRONT_CONTROLLER_REWARM_AFTER_EVIDENCE_ENABLED=0
MIRA_FRONT_CONTROLLER_REWARM_MAX_TOKENS=16
MIRA_FRONT_CONTROLLER_REWARM_DELAY_MS=3000
MIRA_FRONT_CONTROLLER_REWARM_MIN_QUIET_MS=1200
MIRA_FRONT_CONTROLLER_REWARM_MIN_INTERVAL_SECONDS=8
# Phase 20.6: generate compact session summaries after idle by default.
# Prompt injection stays off until continuity + routing/TTFT evals are green.
MIRA_SESSION_SUMMARIES_ENABLED=1
MIRA_SESSION_SUMMARY_CONTEXT_ENABLED=0
MIRA_SESSION_SUMMARY_IDLE_SECONDS=90
# Current safe Mira defaults. These keep useful memory/persona behavior on,
# while still requiring explicit user approval before durable memory is stored.
MIRA_PENDING_STATE_FAST_RESOLVER_ENABLED=1
MIRA_MEMORY_SUGGESTIONS_ENABLED=true
MIRA_MEMORY_PREFERENCE_CONTEXT_ENABLED=true
MIRA_LLM_TEMPORAL_PARSER_ENABLED=1
MIRA_PERSONA_TEMPLATES_ENABLED=true
MIRA_PERSONA_V2_ENABLED=true
MIRA_CONFIDENCE_CAVEATS_ENABLED=true

# -----------------------------------------------------------------
# LLM Provider
# -----------------------------------------------------------------
# "ollama" is the default. "llamacpp" enables the experimental host
# llama.cpp server path for Copilot/controller calls.
LLM_PROVIDER=ollama

# -----------------------------------------------------------------
# Ollama (Local AI mode)
# -----------------------------------------------------------------
# For Docker runtime on macOS/Windows:
OLLAMA_BASE_URL=http://host.docker.internal:11434
#
# For local development runtime:
# OLLAMA_BASE_URL=http://localhost:11434

# Host Ollama server launch settings. These must be present in the process that
# runs `ollama serve`; the backend cannot apply them to an already-running
# Ollama app. Use `scripts/start_mira_ollama.sh` for a reproducible tuned server.
OLLAMA_HOST=127.0.0.1:11434
OLLAMA_NUM_PARALLEL=2
OLLAMA_MULTIUSER_CACHE=1
OLLAMA_KEEP_ALIVE=30m
OLLAMA_PREWARM_KEEP_ALIVE=30m
OLLAMA_CONTROLLER_KEEP_ALIVE=30m
OLLAMA_COPILOT_KEEP_ALIVE=30m

# -----------------------------------------------------------------
# llama.cpp (experimental local Copilot mode)
# -----------------------------------------------------------------
# Run llama-server on the host OS for native Apple Silicon Metal performance.
# Docker backend URL:
# LLAMACPP_BASE_URL=http://host.docker.internal:8081
# Local backend URL:
# LLAMACPP_BASE_URL=http://localhost:8081
# LLAMACPP_MODEL=local
# LLAMACPP_TIMEOUT=240
# LLAMACPP_TEMPERATURE=1.0
# LLAMACPP_TOP_P=0.95
# LLAMACPP_TOP_K=64
# LLAMACPP_THINK=false

# Recommended local default. Gemma 4 E4B uses Ollama's Q4_K_M tag.
# Setup should only promote Advisor to gemma4:26b on systems with >=30GB RAM.
OLLAMA_MODEL_CATEGORIZE=gemma4:e4b
OLLAMA_MODEL_CONTROLLER=gemma4:e4b
OLLAMA_MODEL_COPILOT=gemma4:e4b
OLLAMA_MODEL_RECEIPT=gemma4:e4b
OLLAMA_EMBED_MODEL=nomic-embed-text
MIRA_SEMANTIC_ROUTER=true
MIRA_PLANNER=v1
LOCAL_LLM_MEMORY_TIER=
LOCAL_LLM_RAM_GB=

# Mira background analyst / "Mira Noticed" manual checks.
# Keeps LLM analysis off chat and off automatic dashboard loads by default.
MIRA_BACKGROUND_ANALYST_ENABLED=1
MIRA_BACKGROUND_ANALYST_STORE_ENABLED=1
MIRA_BACKGROUND_ANALYST_AUTO_ENABLED=0
MIRA_BACKGROUND_ANALYST_MIN_INTERVAL_MINUTES=360
MIRA_BACKGROUND_ANALYST_MAX_TOKENS=900
MIRA_BACKGROUND_ANALYST_MAX_DRAFTS=3

# Mira financial understanding store. Deterministic facts are off the chat
# path; optional LLM interpretation stays gated until QA proves it useful.
MIRA_FINANCIAL_UNDERSTANDING_ENABLED=1
MIRA_FINANCIAL_UNDERSTANDING_LLM_ENABLED=0
MIRA_FINANCIAL_UNDERSTANDING_MAX_FACTS=8
MIRA_FINANCIAL_UNDERSTANDING_MAX_TOKENS=900
MIRA_FINANCIAL_CONTEXT_TOOL_ENABLED=1
MIRA_LIFESTYLE_CONTEXT_PROMPT_ENABLED=1
MIRA_FINANCIAL_CONTEXT_MAX_FACTS=5
MIRA_ADVISOR_CASES_ENABLED=0
MIRA_ADVISOR_CARDS_ENABLED=0
MIRA_ADVISOR_BACKGROUND_AUTO_ENABLED=0
MIRA_ADVISOR_CARD_MAX_COUNT=4
MIRA_ADVISOR_SYNTHESIS_ENABLED=0
MIRA_ADVISOR_SYNTHESIS_STORE_ENABLED=0
MIRA_ADVISOR_SYNTHESIS_MAX_OBSERVATIONS=5
MIRA_ADVISOR_SYNTHESIS_MAX_TOKENS=1400
# Guarded stored "Mira's read" path. All three synthesis/store/UI flags must be
# enabled before generation is useful in the product UI. Keep off for a safe
# first install; enable only after local Ollama and data quality are trusted.
MIRA_ADVISOR_LENS_SYNTHESIS_ENABLED=0
MIRA_ADVISOR_LENS_STORE_ENABLED=0
MIRA_ADVISOR_LENS_BACKGROUND_AUTO_ENABLED=0
# Keep the template safe for <30GB systems. Setup may write gemma4:26b on >=30GB RAM.
MIRA_ADVISOR_LENS_MODEL=gemma4:e4b
MIRA_ADVISOR_LENS_THINK=0
MIRA_ADVISOR_LENS_KEEP_ALIVE=2m
MIRA_ADVISOR_LENS_TIMEOUT=600
MIRA_ADVISOR_LENS_MIN_INTERVAL_MINUTES=1440
MIRA_ADVISOR_LENS_MIN_MEMO_CHARS=2200
MIRA_ADVISOR_LENS_MAX_TOKENS=1800
MIRA_ADVISOR_LENS_FINAL_MAX_TOKENS=2600
MIRA_ADVISOR_LENS_CONTEXT_ENABLED=0
MIRA_ADVISOR_LENS_CONTEXT_MAX_CHARS=2200
MIRA_ADVISOR_LENS_CONTEXT_MAX_TOKENS=520
MIRA_ADVISOR_LENS_UI_ENABLED=0
MIRA_ADVISOR_LENS_POST_REWARM_ENABLED=0
MIRA_ADVISOR_LENS_POST_REWARM_PURPOSES=controller
MIRA_ADVISOR_LENS_POST_REWARM_MAX_TOKENS=8
MIRA_FINANCIAL_FEEDBACK_LOOP_ENABLED=0
MIRA_MONEY_OUTLOOK_ENABLED=1
MIRA_SAFE_TO_SPEND_ENABLED=1
MIRA_CASH_LOW_POINT_RADAR_ENABLED=1
MIRA_STATED_INTENT_MEMORY_ENABLED=0
MIRA_HABIT_STREAKS_ENABLED=0
MIRA_MONTHLY_RETROSPECTIVE_ENABLED=0
MIRA_ENRICHMENT_REPAIR_ENABLED=0

# Optional v3 soak trace logging. Enable only for local diagnostics.
# MIRA_SOAK_TRACE_DIR=benchmark_runs/mira_v3_soak_traces
# MIRA_SOAK_TRACE_RAW=false
# MIRA_SOAK_TRACE_PROMPT=false
#
# Advanced/high-memory Advisor option, only for systems with >=30GB RAM.
# MIRA_ADVISOR_LENS_MODEL=gemma4:26b

# Number of merchant descriptions to normalize per enrichment call.
LOCAL_ENRICHMENT_BATCH_SIZE=20
# Minimum accepted confidence from local merchant normalization: low|medium|high
LOCAL_ENRICHMENT_MIN_CONFIDENCE=medium
# Timeouts in seconds. Increase if your hardware is slower.
OLLAMA_TIMEOUT_CATEGORIZE=600
OLLAMA_TIMEOUT_CONTROLLER=90
OLLAMA_TIMEOUT_COPILOT=240
OLLAMA_TIMEOUT_ADVISOR=600
OLLAMA_PREWARM_TTL_SECONDS=240

# -----------------------------------------------------------------
# Optional DistilBERT Categorization Backend
# -----------------------------------------------------------------
# Requires installing backend/requirements-distilbert.in dependencies and
# either mounting a local model directory or allowing a Hugging Face download.
DISTILBERT_CATEGORIZATION_MODEL=DoDataThings/distilbert-us-transaction-classifier-v2
DISTILBERT_MODEL_PATH=/models/distilbert-us-transaction-classifier-v2
DISTILBERT_LOCAL_FILES_ONLY=true
DISTILBERT_ALLOW_DOWNLOAD=false
DISTILBERT_REQUIRED=false
DISTILBERT_CONFIDENCE_THRESHOLD=0.90
DISTILBERT_BATCH_SIZE=64
DISTILBERT_SHADOW=false

# -----------------------------------------------------------------
# Trove Merchant Enrichment (optional)
# -----------------------------------------------------------------
# Optional cloud merchant enrichment. Keep disabled if you want a fully local stack.
TROVE_API_KEY=
TROVE_USER_SEED=Folio-self-hosted

# -----------------------------------------------------------------
# Frontend / App Settings
# -----------------------------------------------------------------
VITE_TELLER_APP_ID=
VITE_TELLER_ENVIRONMENT=sandbox
# Background provider sync. Folio checks persisted last successful provider
# sync timestamps, so a restart after the interval still triggers a sync.
FOLIO_AUTO_SYNC_ENABLED=true
FOLIO_AUTO_SYNC_INTERVAL_HOURS=12
FOLIO_AUTO_SYNC_STARTUP_DELAY_SECONDS=30
FOLIO_AUTO_SYNC_CHECK_SECONDS=300
FOLIO_AUTO_SYNC_FAILURE_BACKOFF_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# -----------------------------------------------------------------
# Docker Settings
# -----------------------------------------------------------------
INSTALL_DISTILBERT=false
BACKEND_PORT=8000
FRONTEND_PORT=3000
DB_FILE=Folio.db
TRUSTED_HOSTS=localhost,127.0.0.1,backend

# -----------------------------------------------------------------
# Copilot History Storage Limits
# -----------------------------------------------------------------
# Full answers are streamed to the browser. SQLite stores bounded previews
# and audit metadata only, so long general chats do not become huge DB rows.
COPILOT_HISTORY_CHAT_PREVIEW_CHARS=1000
COPILOT_HISTORY_FINANCE_PREVIEW_CHARS=4000
COPILOT_HISTORY_RESULT_CHARS=8000
COPILOT_HISTORY_SQL_CHARS=8000
COPILOT_HISTORY_MAX_ROWS=500
SQLITE_CONNECT_RETRIES=3
SQLITE_BUSY_TIMEOUT_MS=10000
